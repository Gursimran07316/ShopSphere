@model IEnumerable<CoreBusiness.Transaction>

    <table class="table">
        <thead>
            <tr>
                <th>Cashier Name</th>
                <th>Product Name</th>
                <th>Date time</th>
            <th>Qty Before</th>
            <th>Qty Sold</th>
            <th>Qty After</th>
            <th>Sold Amt</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var t in Model)
        {
            <tr>
                <td>@t.CashierName</td>
                <td>@t.ProductName</td>
                <td>@t.TimeStamp.ToString("MM/dd hh:mm")</td>
                <td>@t.BeforeQty</td>
                <td>@t.SoldQty</td>
                <td>@(t.BeforeQty - t.SoldQty)</td>
                
                <td>@( string.Format("{0:c}",t.SoldQty * t.Price))</td>
            </tr>
        }
        </tbody>
    </table>